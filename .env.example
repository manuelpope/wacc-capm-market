# The env file of the project.
#
#   cp .env.example .env
#
# The app reads it when it starts, so the model gateway is picked up without
# an export in the shell. A real environment variable always wins over the
# file. The short names below are aliases of the canonical ones.

# --------------------------------------------------------------- the analyst
# The model gateway. A URL that carries only a host and a port gets the
# `/v1` prefix of the OpenAI-compatible API.
WACC_LAB_LLM_BASE_URL=http://127.0.0.1:11434/v1
WACC_LAB_LLM_MODEL=qwen3.5:9b-mlx
# Only for a gateway that asks for a key.
WACC_LAB_LLM_API_KEY=
# The account the request is billed to.
WACC_LAB_LLM_USER=
# 180 seconds. A reasoning model needs more.
WACC_LAB_LLM_TIMEOUT=180
# "chat" for /v1/chat/completions, "completions" for llama.cpp servers.
WACC_LAB_LLM_MODE=chat
# 0 turns the whole analyst step off.
WACC_LAB_LLM_ENABLED=1
# "none" asks for no reasoning, "omit" leaves the field out of the request.
# A reasoning model that always thinks rejects "none".
WACC_LAB_LLM_REASONING_EFFORT=none

# ---------------------------------------------------------------- the store
WACC_LAB_DB=data/wacc_lab.db
WACC_LAB_TTL_HOURS=24
WACC_LAB_NEWS_TTL_HOURS=6
WACC_LAB_NEWS_LIMIT=8
